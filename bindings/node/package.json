{
  "name": "@motedb/motedb",
  "version": "0.15.0",
  "description": "AI-native embedded multimodal database — Node.js bindings.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/motedb/motedb.git"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">= 18"
  },
  "napi": {
    "binaryName": "motedb",
    "package": {
      "name": "@motedb/motedb-{{platform}}{{arch}}{{libc}}"
    },
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "optionalDependencies": {
    "@motedb/motedb-darwin-x64": "0.15.0",
    "@motedb/motedb-darwin-arm64": "0.15.0",
    "@motedb/motedb-linux-x64-gnu": "0.15.0",
    "@motedb/motedb-linux-arm64-gnu": "0.15.0",
    "@motedb/motedb-win32-x64-msvc": "0.15.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
