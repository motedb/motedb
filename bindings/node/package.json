{
  "name": "motedb",
  "version": "0.15.2",
  "description": "AI-native embedded multimodal database for embodied AI & robotics — vectors, time series, full text and binary in one embedded SQL engine. Node.js bindings (napi-rs).",
  "license": "MIT",
  "homepage": "https://motedb.github.io",
  "bugs": {
    "url": "https://github.com/motedb/motedb/issues"
  },
  "keywords": [
    "database",
    "embedded-database",
    "multimodal-database",
    "vector-database",
    "vector-search",
    "time-series",
    "full-text-search",
    "sql",
    "robotics",
    "embodied-ai",
    "edge-ai",
    "mcap",
    "sqlite-alternative",
    "rust",
    "napi-rs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/motedb/motedb.git"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">= 18"
  },
  "napi": {
    "binaryName": "motedb",
    "package": {
      "name": "motedb-{{platform}}{{arch}}{{libc}}"
    },
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "optionalDependencies": {
    "motedb-darwin-x64": "0.15.2",
    "motedb-darwin-arm64": "0.15.2",
    "motedb-linux-x64-gnu": "0.15.2",
    "motedb-linux-arm64-gnu": "0.15.2",
    "motedb-win32-x64-msvc": "0.15.2"
  }
}
